{
  "permissions": {
    "allow": [
      "mcp__honcho",
      "Bash(cd *)",
      "Bash(hmt *)",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/ripwire/hooks/ripwire-claude-route.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-notify 'Claude needs input' Submarine",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-push-guard.sh",
            "statusMessage": "Checking repo ownership for push"
          }
        ]
      },
      {
        "matcher": "^(Read|Glob|Grep|Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__ripwire__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/ripwire/hooks/ripwire-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-notify 'Claude finished' Glass",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/ripwire/hooks/ripwire-nudge.sh --session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/statusline-dense.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  }
}
